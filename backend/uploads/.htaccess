# Disable script execution in uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|phar|pl|py|cgi|sh|bash|exe|cmd|bat)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Prevent directory listings and script execution
Options -Indexes -ExecCGI
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
