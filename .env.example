# FoundIt Environment Configuration

# Application Environment (development | production)
APP_ENV=development
APP_DEBUG=true

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=foundit_db

# CORS Allowed Origins (comma-separated list for custom domains/ports)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@foundit.local
MAIL_FROM_NAME=FoundIt
